#include "..\headers\define.h"
#include "..\headers\sfall\sfall.h"
#include ".\BookAsh.h"
//---------------------

#define NAME                            SCRIPT_BookAsh
#define TOWN_REP_VAR                    GVAR_TOWN_REP_PHOENIX

#define NUM_TEAM                        TEAM_GHOUL_WILD
#define NUM_AI                          AI_GUARDS
#define KILL_SLAVA                      SLAVA_KILL_GOOD
#define KILL_TOWN_REP                   REP_KILL_GOOD
#define KILL_FRAC_REP                   FRAC_NON

#define FLAG_STEAL                      60
#define FLAG_ALCOHOL                    1
#define FLAG_FOOD                       0

//---------------------

procedure start;
procedure look_at_p_proc;
procedure description_p_proc;
procedure map_enter_p_proc;
procedure map_update_p_proc;
procedure critter_p_proc;
procedure timed_event_p_proc;
procedure damage_p_proc;
procedure pickup_p_proc;
procedure use_obj_on_p_proc;
procedure use_skill_on_p_proc;
